{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "jsx": "react-jsx", "jsxImportSource": "preact", "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["apps", "packages", "tests", "tools/*.ts", "*.ts"]
}
